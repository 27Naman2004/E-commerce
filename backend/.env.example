# Environment Variables Template for Kanha Collection Backend

# Application Profile & Server Configuration
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# PostgreSQL Configuration
DB_URL=jdbc:postgresql://localhost:5432/kanha_db
DB_USERNAME=kanha_user
DB_PASSWORD=kanha_pass
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_SSL_ENABLED=false

# JWT Security
# Must be at least 256 bits (32 bytes) secret key encoded in Base64 or plain string
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Razorpay Integration
RAZORPAY_KEY_ID=rzp_test_sampleKeyId
RAZORPAY_KEY_SECRET=sampleRazorpaySecretKey

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=sampleCloudinarySecret
