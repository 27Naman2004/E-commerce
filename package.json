{
  "name": "kanha-collection",
  "version": "1.0.0",
  "description": "Kanha Collection - E-commerce Application",
  "private": true,
  "workspaces": [
    "kanha-vite",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w kanha-vite\" \"npm run dev -w server\"",
    "dev:frontend": "npm run dev -w kanha-vite",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w kanha-vite"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
