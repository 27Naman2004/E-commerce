NODE_ENV=development
PORT=5000

# MongoDB - Update with your connection string
MONGO_URI=mongodb://localhost:27017/kanha-collection

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_production

# Frontend URL (for CORS + reset password links)
FRONTEND_URL=http://localhost:5174

# Cloudinary (optional for development)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gmail SMTP for email OTP
WEBSITE_NAME=Kanha Collection
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password
EMAIL_FROM="Kanha Collection <your_email@gmail.com>"
OTP_EXPIRY_MINUTES=5
