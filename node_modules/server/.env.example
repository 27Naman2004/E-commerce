# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/kanha-collection

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_and_random_secret
JWT_EXPIRE=7d

# ─── MSG91 (SMS OTP for Phone Authentication) ──────────────────────────────────
# Sign up at https://msg91.com
# 1. Get your Auth Key from Dashboard → API Keys
# 2. Go to Verify → Create OTP Template (must be TRAI-approved for Indian numbers)
# 3. Copy Template ID
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# ─── Resend (Email OTP Delivery) ───────────────────────────────────────────────
# Sign up at https://resend.com
# 1. Add and verify your domain (or use onboarding@resend.dev for tests)
# 2. Create API key from dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Kanha Collection <noreply@yourdomain.com>"
# For testing without a custom domain, use:
# EMAIL_FROM=onboarding@resend.dev

# ─── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
